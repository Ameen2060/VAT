# ─────────────────────────────────────────────────────────────
# UAE VAT Compliance Platform — environment configuration
# Copy to `.env` and fill in. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=development
APP_NAME="UAE VAT Compliance Platform"
SECRET_KEY=change-me-to-a-long-random-string
API_CORS_ORIGINS=http://localhost:3000

# Database
# Dev (no Docker): SQLite
DATABASE_URL=sqlite:///./data/vat.sqlite3
# Production / Docker: PostgreSQL with pgvector
# DATABASE_URL=postgresql+psycopg://vat:vat@localhost:5432/vat

# Object storage (MinIO / S3). Leave S3_* blank to use local-folder storage in dev.
STORAGE_BACKEND=local            # local | s3
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vat-documents
S3_REGION=us-east-1

# Redis (background jobs). Optional in dev.
REDIS_URL=redis://localhost:6379/0

# AI provider (provider-agnostic layer). No key required for the rule engine.
AI_PROVIDER=anthropic            # anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_EMBEDDING_MODEL=

# VAT domain constants (overridable; defaults follow current UAE law)
VAT_STANDARD_RATE=0.05
VAT_MANDATORY_REG_THRESHOLD_AED=375000
VAT_VOLUNTARY_REG_THRESHOLD_AED=187500
VAT_SIMPLIFIED_INVOICE_MAX_AED=10000
